<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        CircuitX - Checkout
    </title>

    <link
        rel="stylesheet"
        href="/css/checkout.css"
    >

</head>


<body>
<!-- ================= NAVBAR ================= -->

<header class="navbar">


    <div class="brand">

        <div class="brand-name">
            Circuit<span>X</span>
        </div>

        <div class="tagline">
            Reuse. Save. Build.
        </div>

    </div>


    <nav class="nav-links">

        <a href="/">Home</a>

        <a href="/browse">Browse</a>

        <a href="/categories">Categories</a>

        <a href="/dashboard">Dashboard</a>

        <a href="/wishlist">Wishlist</a>

    </nav>


    <div class="nav-actions">

        <a href="/cart">
            🛒
        </a>

        <span>
            ♡
        </span>

        <span>
            👤
        </span>

        <div class="profile-name">

            <strong>
                Purvesh Thite
            </strong>

            <small>
                My Profile
            </small>

        </div>

    </div>


</header>
<!-- ================= CHECKOUT ================= -->

<main class="checkout-page">


    <!-- Breadcrumb -->

    <div class="breadcrumb">

        <a href="/">Home</a>

        <span>›</span>

        <a href="/cart">Cart</a>

        <span>›</span>

        <strong>Checkout</strong>

    </div>


    <h1>
        Checkout
    </h1>



    <div class="checkout-layout">
        <!-- ================= LEFT ================= -->

        <div class="checkout-left">
            <!-- DELIVERY -->

            <section class="checkout-card">


                <div class="section-title">

                    <span class="number">
                        1
                    </span>

                    <h2>
                        Delivery / Contact Details
                    </h2>

                </div>


                <div class="form-group">

                    <label>
                        Full Name
                    </label>

                    <input
                        type="text"
                        id="fullName"
                        placeholder="Enter full name"
                    >

                </div>


                <div class="form-group">

                    <label>
                        Phone Number
                    </label>

                    <input
                        type="tel"
                        id="phone"
                        placeholder="+91 XXXXX XXXXX"
                    >

                </div>


                <div class="form-group">

                    <label>
                        Email
                    </label>

                    <input
                        type="email"
                        id="email"
                        placeholder="example@gmail.com"
                    >

                </div>


                <div class="form-group">

                    <label>
                        College / Organization
                    </label>

                    <input
                        type="text"
                        id="college"
                        placeholder="Enter college or organization"
                    >

                </div>


                <div class="form-group">

                    <label>
                        Address
                    </label>

                    <input
                        type="text"
                        id="address"
                        placeholder="Flat No, Street, Area"
                    >

                </div>


                <div class="location-grid">


                    <div class="form-group">

                        <label>
                            City
                        </label>

                        <input
                            type="text"
                            id="city"
                            placeholder="Pune"
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            State
                        </label>

                        <select id="state">

                            <option value="">
                                Select State
                            </option>

                            <option value="Maharashtra">
                                Maharashtra
                            </option>

                            <option value="Gujarat">
                                Gujarat
                            </option>

                            <option value="Karnataka">
                                Karnataka
                            </option>

                            <option value="Delhi">
                                Delhi
                            </option>

                        </select>

                    </div>


                    <div class="form-group">

                        <label>
                            Pincode
                        </label>

                        <input
                            type="text"
                            id="pincode"
                            maxlength="6"
                            placeholder="411045"
                        >

                    </div>


                </div>


                <label class="checkbox">

                    <input
                        type="checkbox"
                        id="saveAddress"
                    >

                    Save this address for future orders

                </label>


            </section>
            <!-- PAYMENT -->

            <section class="checkout-card">


                <div class="section-title">

                    <span class="number">
                        2
                    </span>

                    <h2>
                        Payment Method
                    </h2>

                </div>
                <!-- UPI -->

                <label class="payment-option">


                    <input
                        type="radio"
                        name="paymentMethod"
                        value="UPI"
                    >


                    <div>

                        <strong>
                            UPI / QR Code
                        </strong>

                        <span class="recommended">
                            Recommended
                        </span>

                        <p>
                            Google Pay • PhonePe • Paytm
                        </p>

                    </div>


                </label>
                <!-- CARD -->

                <label class="payment-option">


                    <input
                        type="radio"
                        name="paymentMethod"
                        value="CARD"
                    >


                    <div>

                        <strong>
                            Credit / Debit Card
                        </strong>

                        <p>
                            Visa • Mastercard • RuPay
                        </p>

                    </div>


                </label>
                <!-- COD -->

                <label class="payment-option">


                    <input
                        type="radio"
                        name="paymentMethod"
                        value="COD"
                    >


                    <div>

                        <strong>
                            Cash on Delivery
                        </strong>

                        <p>
                            Pay when you receive
                        </p>

                    </div>


                </label>


            </section>
            <!-- NOTE -->

            <section class="checkout-card">


                <div class="section-title">

                    <span class="number">
                        3
                    </span>

                    <h2>
                        Additional Note
                        <small>
                            (Optional)
                        </small>
                    </h2>

                </div>


                <textarea
                    id="orderNote"
                    placeholder="Add any special instructions for the seller..."
                ></textarea>


            </section>


        </div>
        <!-- ================= RIGHT ================= -->

        <aside class="order-summary">


            <h2>
                Order Summary
            </h2>


            <!-- Products -->

            <div id="checkoutItems">

                <!-- Products loaded by JS -->

            </div>


            <hr>


            <div class="summary-row">

                <span>
                    Subtotal
                </span>

                <strong id="checkoutSubtotal">
                    ₹0.00
                </strong>

            </div>


            <div class="summary-row">

                <span>
                    Shipping Charges
                </span>

                <strong id="checkoutShipping">
                    ₹0.00
                </strong>

            </div>


            <div class="summary-row discount">

                <span>
                    Discount
                </span>

                <strong id="checkoutDiscount">
                    - ₹0.00
                </strong>

            </div>


            <hr>


            <div class="total-row">

                <strong>
                    Total Amount
                </strong>

                <strong id="checkoutTotal">
                    ₹0.00
                </strong>

            </div>



            <div class="secure-box">

                🛡

                <div>

                    <strong>
                        100% Secure Checkout
                    </strong>

                    <p>
                        Your information is safe with us
                    </p>

                </div>

            </div>



            <button
                class="place-order-btn"
                onclick="placeOrder()"
            >
                🔒 Place Order
            </button>


            <p class="terms">

                By placing the order, you agree to CircuitX

                <a href="#">
                    Terms & Conditions
                </a>

                and

                <a href="#">
                    Privacy Policy
                </a>.

            </p>


        </aside>


    </div>

</main>



<!-- ================= FOOTER ================= -->

<footer class="checkout-footer">


    <div>

        🔒

        <strong>
            Safe & Secure
        </strong>

        <p>
            Secure SSL Encryption
        </p>

    </div>


    <div>

        🚚

        <strong>
            Fast Delivery
        </strong>

        <p>
            Quick delivery
        </p>

    </div>


    <div>

        ♻

        <strong>
            Easy Returns
        </strong>

        <p>
            7 days return policy
        </p>

    </div>


    <div>

        👥

        <strong>
            Support
        </strong>

        <p>
            24/7 Support
        </p>

    </div>


</footer>


<script src="/js/checkout.js"></script>

</body>

</html>