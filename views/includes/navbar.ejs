<nav class="navbar">

    <!-- Logo -->
    <a href="/home" class="logo">

        <div class="logo-icon">
            <span>✦</span>
        </div>

        <div class="logo-text">
            <h2>Circuit<span>X</span></h2>
            <p>Reuse. Save. Build.</p>
        </div>

    </a>


    <!-- Navigation Links -->
    <div class="nav-links">

        <a href="/home"
           class="<%= activePage === 'home' ? 'active' : '' %>">
            Home
        </a>

        <a href="/browse"
           class="<%= activePage === 'browse' ? 'active' : '' %>">
            Browse
        </a>

        <a href="/categories"
           class="<%= activePage === 'categories' ? 'active' : '' %>">
            Categories
        </a>

        <a href="/dashboard"
           class="<%= activePage === 'dashboard' ? 'active' : '' %>">
            Dashboard
        </a>

        <a href="/wishlist"
           class="<%= activePage === 'wishlist' ? 'active' : '' %>">
            Wishlist
        </a>

    </div>


    <!-- Right Side -->
    <div class="nav-right">

        <% if (typeof user !== "undefined" && user) { %>

            <!-- Cart -->
            <button class="icon-btn" aria-label="Cart">
                🛒
            </button>

            <!-- Notifications -->
            <button class="icon-btn" aria-label="Notifications">
                ♡
            </button>

            <!-- Profile -->
            <a href="/dashboard" class="profile-section">

                <div class="profile-avatar">
                    <span>👤</span>
                </div>

                <div class="profile-info">

                    <span class="profile-name">
                        <%= user.name %>
                    </span>

                    <span class="profile-label">
                        My Profile
                    </span>

                </div>

            </a>

            <!-- Logout -->
            <a href="/logout" class="logout-link">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
            </a>

        <% } else { %>

            <a href="/login" class="auth-btn login-btn-nav">Login</a>
            <a href="/register" class="auth-btn register-btn-nav">Register</a>

        <% } %>

    </div>

</nav>