<% layout("/layouts/boilerplate") %>
 
<style>
    /* ================= HERO ================= */

.hero {
    min-height: 310px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 40px 38px 25px;

    background:
        radial-gradient(
            circle at 80% 50%,
            #effcf6 0%,
            transparent 35%
        );
}

.hero-content {
    width: 54%;
}

.tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;

    background: #e8f8f1;
    color: #00875a;

    padding: 5px 9px;

    border-radius: 20px;

    font-size: 12px;
    font-weight: 600;

    margin-bottom: 13px;
}

.hero h1 {
    font-size: 33px;
    line-height: 1.17;

    letter-spacing: -1px;

    font-weight: 800;

    margin-bottom: 13px;
}

.hero h1 span {
    color: #009b63;
}

.hero p {
    font-size: 14px;
    line-height: 1.6;

    color: #4b5563;

    margin-bottom: 19px;
}

.hero-buttons {
    display: flex;
    gap: 13px;
}

.primary-btn,
.secondary-btn {
    text-decoration: none;

    font-size: 15px;
    font-weight: 600;

    padding: 11px 19px;

    border-radius: 6px;
}

.primary-btn {
    background: #009b63;
    color: white;
}

.secondary-btn {
    border: 1px solid #009b63;

    color: #009b63;

    background: white;
}


/* ================= HERO IMAGE ================= */

.hero-image {
    position: relative;

    width: 42%;
    height: 270px;
}

.recycle-bin {
    position: absolute;

    right: 50px;
    bottom: 13px;

    width: 130px;
    height: 130px;
}

.bin {
    position: absolute;

    bottom: 0;
    left: 0;

    width: 120px;
    height: 75px;

    background: #009b63;

    border-radius: 5px 5px 18px 18px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: white;

    font-size: 45px;

    transform: perspective(200px) rotateX(-5deg);
}

.electronic-board {
    position: absolute;

    width: 58px;
    height: 35px;

    background: #1d4f70;

    border-radius: 4px;

    left: 32px;
    top: 12px;

    z-index: 2;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #76d6a9;

    transform: rotate(-10deg);
}

.floating-chip {
    position: absolute;

    width: 35px;
    height: 35px;

    background: #164f73;

    border-radius: 4px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #7ee1b4;

    font-size: 18px;

    box-shadow: 0 8px 15px rgba(0, 0, 0, 0.12);
}

.chip1 {
    left: 55px;
    top: 48px;

    transform: rotate(-18deg);
}

.chip2 {
    right: 55px;
    top: 40px;

    transform: rotate(20deg);
}

.chip3 {
    right: 20px;
    top: 105px;

    transform: rotate(-15deg);
}

.chip4 {
    left: 110px;
    top: 125px;

    transform: rotate(20deg);
}

.leaf {
    position: absolute;

    color: #c9ebdc;

    font-size: 27px;
}

.leaf1 {
    right: 10px;
    top: 55px;
}

.leaf2 {
    right: 90px;
    top: 5px;
}

.leaf3 {
    left: 25px;
    bottom: 35px;
}

.leaf4 {
    right: 35px;
    bottom: 15px;
}


/* ================= FEATURES ================= */

.features {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 12px;

    padding: 0 38px 28px;
}

.feature-card {
    min-height: 80px;

    background: #f2f3f5;

    border-radius: 8px;

    display: flex;
    align-items: center;

    gap: 10px;

    padding: 10px;
}

.feature-icon {
    min-width: 50px;
    height: 50px;

    border: 2px solid #00a66a;

    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #00a66a;

    font-size: 20px;
}

.feature-card h3 {
    font-size: 15px;

    margin-bottom: 3px;
}

.feature-card p {
    color: #6b7280;

    font-size: 10px;

    line-height: 1.4;
}


/* ================= COMMON SECTION ================= */

.section {
    padding: 0 38px 28px;
}

.section-heading {
    display: flex;

    align-items: center;
    justify-content: space-between;

    margin-bottom: 13px;
}

.section-heading h2 {
    font-size: 15px;

    font-weight: 700;
}

.section-heading a {
    color: #009b63;

    text-decoration: none;

    font-size: 12px;

    font-weight: 600;
}


/* ================= CATEGORIES ================= */

.categories {
    display: grid;

    grid-template-columns: repeat(8, 1fr);

    gap: 10px;
}

.category {
    text-decoration: none;

    text-align: center;

    color: #111827;
}

.category-img {
    height: 75px;

    background: #f2f3f5;

    border-radius: 8px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 6px;

    overflow: hidden;
}

.category-img img {
    width: 90px;
    height: 70px;

    object-fit: contain;
}

.category p {
    font-size: 13px;

    color: #374151;
}

.category-img.more {
    color: #008f5a;

    font-size: 40px;
}


/* ================= LISTINGS ================= */

.latest-section {
    padding-bottom: 40px;
}

.listings {
    display: grid;

    grid-template-columns: repeat(5, 1fr);

    gap: 10px;
}

.listing-card {
    background: white;

    border: 1px solid #eeeeee;

    border-radius: 8px;

    overflow: hidden;

    transition: 0.2s;
}

.listing-card:hover {
    transform: translateY(-3px);

    box-shadow:
        0 7px 20px rgba(0, 0, 0, 0.08);
}

.listing-image {
    height: 108px;

    background: #f7f8f9;

    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;
}

.listing-image img {
    width: 80%;
    height: 80%;

    object-fit: contain;
}

.wishlist {
    position: absolute;

    right: 7px;
    top: 7px;

    width: 18px;
    height: 18px;

    border: none;

    background: transparent;

    cursor: pointer;

    color: #9ca3af;

    font-size: 11px;
}

.wishlist:hover {
    color: #ef4444;
}

.listing-info {
    padding: 8px;
}

.listing-info h3 {
    font-size: 13px;

    font-weight: 600;

    margin-bottom: 7px;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;
}

.listing-bottom {
    display: flex;

    justify-content: space-between;

    align-items: center;
}

.listing-bottom strong {
    font-size: 12px;
}

.listing-bottom span {
    color: #6b7280;

    font-size: 10px;
}


/* ================= RESPONSIVE ================= */

@media (max-width: 900px) {

    .hero h1 {
        font-size: 26px;
    }

    .categories {
        grid-template-columns: repeat(4, 1fr);
    }

    .listings {
        grid-template-columns: repeat(3, 1fr);
    }
}

html {
    scrollbar-width: none;
}

html::-webkit-scrollbar {
    display: none;
}


@media (max-width: 650px) {

    .hero {
        flex-direction: column;

        padding: 30px 20px;
    }

    .hero-content {
        width: 100%;
    }

    .hero-image {
        width: 100%;

        margin-top: 20px;
    }

    .features {
        grid-template-columns: repeat(2, 1fr);

        padding: 0 20px 25px;
    }

    .section {
        padding-left: 20px;

        padding-right: 20px;
    }

    .categories {
        grid-template-columns: repeat(4, 1fr);
    }

    .listings {
        grid-template-columns: repeat(2, 1fr);
    }
}
</style>

<!-- ================= HERO SECTION ================= -->

<section class="hero">

    <div class="hero-content">

        <div class="tag">
            <i class="fa-solid fa-leaf"></i>
            Sustainable Future
        </div>

        <h1>
            Buy & Sell<br>
            Electronic <span>Components</span><br>
            Used by Students,<br>
            Loved by All.
        </h1>

        <p>
            Give your components a second life.<br>
            Save money. Reduce e-waste. Support sustainability.
        </p>

        <div class="hero-buttons">
            <a href="/browse" class="primary-btn">
                Browse Components
            </a>

            <a href="/sell" class="secondary-btn">
                Sell Your Component
            </a>
        </div>

    </div>


    <!-- Hero Illustration -->

    <div class="hero-image">

        <div class="floating-chip chip1">
            <i class="fa-solid fa-microchip"></i>
        </div>

        <div class="floating-chip chip2">
            <i class="fa-solid fa-microchip"></i>
        </div>

        <div class="floating-chip chip3">
            <i class="fa-solid fa-microchip"></i>
        </div>

        <div class="floating-chip chip4">
            <i class="fa-solid fa-microchip"></i>
        </div>
        

        <div class="recycle-bin">

            <div class="electronic-board">
                <i class="fa-solid fa-microchip"></i>
            </div>

            <div class="bin">
                <i class="fa-solid fa-recycle"></i>
            </div>

        </div>

        <div class="leaf leaf1">🍃</div>
        <div class="leaf leaf2">🍃</div>
        <div class="leaf leaf3">🍃</div>
        <div class="leaf leaf4">🍃</div>

    </div>

</section>


<!-- ================= FEATURES ================= -->

<section class="features">

    <div class="feature-card">

        <div class="feature-icon">
            <i class="fa-solid fa-location-dot"></i>
        </div>

        <div>
            <h3>Affordable</h3>
            <p>Save up to 60% on components</p>
        </div>

    </div>


    <div class="feature-card">

        <div class="feature-icon">
            <i class="fa-solid fa-recycle"></i>
        </div>

        <div>
            <h3>Sustainable</h3>
            <p>Reduce electronic waste and help environment</p>
        </div>

    </div>


    <div class="feature-card">

        <div class="feature-icon">
            <i class="fa-solid fa-users"></i>
        </div>

        <div>
            <h3>Trusted Students</h3>
            <p>Buy & sell with your college community</p>
        </div>

    </div>


    <div class="feature-card">

        <div class="feature-icon">
            <i class="fa-solid fa-shield-halved"></i>
        </div>

        <div>
            <h3>Easy & Safe</h3>
            <p>Simple process and secure interactions</p>
        </div>

    </div>

</section>


<!-- ================= POPULAR CATEGORIES ================= -->

<section class="section">

    <div class="section-heading">

        <h2>Popular Categories</h2>

        <a href="/categories">
            View All
        </a>

    </div>


    <div class="categories">

        <a href="/categories/arduino" class="category">

            <div class="category-img">
                <img src="/images/aurdino.png" alt="Arduino">
            </div>

            <p>Arduino</p>

        </a>


        <a href="/categories/sensors" class="category">

            <div class="category-img">
                <img src="/images/sensors.png" alt="Sensors">
            </div>

            <p>Sensors</p>

        </a>


        <a href="/categories/motors" class="category">

            <div class="category-img">
                <img src="/images/motor.png" alt="Motors">
            </div>

            <p>Motors</p>

        </a>


        <a href="/categories/esp32" class="category">

            <div class="category-img">
                <img src="/images/esp32.png" alt="ESP32">
            </div>

            <p>ESP32 / ESP8266</p>

        </a>


        <a href="/categories/ics" class="category">

            <div class="category-img">
                <img src="/images/ICs.png" alt="ICs">
            </div>

            <p>ICs</p>

        </a>


        <a href="/categories/power-supply" class="category">

            <div class="category-img">
                <img src="/images/power_supply.png" alt="Power Supply">
            </div>

            <p>Power Supply</p>

        </a>


        <a href="/categories/robotics" class="category">

            <div class="category-img">
                <img src="/images/robotics.png" alt="Robotics">
            </div>

            <p>Robotics</p>

        </a>


        <a href="/categories" class="category">

            <div class="category-img more">
                <i class="fa-solid fa-grip"></i>
            </div>

            <p>More</p>

        </a>

    </div>

</section>


<!-- ================= LATEST LISTINGS ================= -->

<section class="section latest-section">

    <div class="section-heading">

        <h2>Latest Listings</h2>

        <a href="/browse">
            View All
        </a>

    </div>


   <div class="listings">

    <% for (let product of products) { %>

        <div class="listing-card">

            <div class="listing-image">
                <img src="<%= product.image_url %>"
                     alt="<%= product.product_name %>">

                <button class="wishlist">
                    <i class="fa-regular fa-heart"></i>
                </button>
            </div>

            <div class="listing-info">

                <h3><%= product.product_name %></h3>

                <div class="listing-bottom">
                    <strong>₹<%= product.Price %></strong>
                    <span><%= product.discount %>% OFF</span>
                </div>

            </div>

        </div>

    <% } %>

</div>

</section>




