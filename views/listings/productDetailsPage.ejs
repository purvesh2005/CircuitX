<% layout("/layouts/boilerplate") %>

<style>

/* =====================================================
   CIRCUITX - PRODUCT DETAILS
   ===================================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html,
body {
    width: 100%;
    height: 100%;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f8faf9;
    color: #1f2937;
}


/* =====================================================
   MAIN PAGE
   ===================================================== */

.product-page {
    width: 100%;
    max-width: 1200px;

    min-height: 100vh;

    margin: 0 auto;
    padding: 28px 24px;

    background: #ffffff;

    border-radius: 0 0 10px 10px;
}


/* =====================================================
   BREADCRUMB
   ===================================================== */

.breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;

    margin-bottom: 20px;

    font-size: 15px;
    color: #6b7280;
}

.breadcrumb a {
    color: #059669;
    text-decoration: none;
}

.breadcrumb a:hover {
    text-decoration: underline;
}

.breadcrumb span {
    color: #9ca3af;
}


/* =====================================================
   PRODUCT CONTAINER
   ===================================================== */

.product-container {
    display: grid;

    grid-template-columns: 47% 53%;

    gap: 30px;
}


/* =====================================================
   LEFT SIDE
   ===================================================== */

.product-left {
    width: 100%;
}


/* =====================================================
   MAIN IMAGE
   ===================================================== */

.main-image {
    width: 100%;
    height: 410px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #f8f9f9;

    border: 1px solid #e1e5e3;
    border-radius: 8px;

    overflow: hidden;
}

.main-image img {
    width: 90%;
    height: 90%;

    object-fit: contain;
}


/* =====================================================
   RIGHT SIDE
   ===================================================== */

.product-right {
    min-width: 0;

    padding: 4px 20px 0 5px;
}


/* =====================================================
   TITLE
   ===================================================== */

.title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 14px;
}

.title-row h1 {
    font-size: 25px;
    font-weight: 600;

    color: #111827;
}


/* =====================================================
   PRICE
   ===================================================== */

.price-section {
    display: flex;
    align-items: center;

    gap: 12px;

    margin-bottom: 18px;
}

.price {
    font-size: 22px;
    font-weight: 700;

    color: #111827;
}

.price-section del {
    font-size: 13px;
    color: #9ca3af;
}

.discount {
    padding: 5px 8px;

    background: #e5f6ee;
    color: #059669;

    border-radius: 4px;

    font-size: 12px;
    font-weight: 600;
}

.stock {
    margin-left: auto;

    padding: 7px 10px;

    background: #e5f6ee;
    color: #059669;

    border-radius: 5px;

    font-size: 12px;
    font-weight: 600;
}


/* =====================================================
   PRODUCT META
   ===================================================== */

.product-meta {
    display: flex;
    flex-wrap: wrap;

    gap: 14px 20px;

    font-size: 12px;

    color: #5f6663;
}

.product-meta span {
    display: flex;
    align-items: center;

    gap: 6px;
}

.product-meta i {
    color: #6b7280;
    font-size: 10px;
}


/* =====================================================
   DIVIDER
   ===================================================== */

.divider {
    width: 100%;
    height: 1px;

    background: #e5e7eb;

    margin: 17px 0;
}


/* =====================================================
   DESCRIPTION
   ===================================================== */

.description h3 {
    margin-bottom: 11px;

    font-size: 15px;
    font-weight: 600;

    color: #111827;
}

.description p {
    margin-bottom: 7px;

    font-size: 12px;
    line-height: 1.4;

    color: #4b5563;
}


/* =====================================================
   SELLER CARD
   ===================================================== */

.seller-card {
    width: 100%;

    margin-top: 20px;
    padding: 13px;

    border: 1px solid #e1e5e3;
    border-radius: 7px;

    background: #ffffff;
}

.seller-card h3 {
    margin-bottom: 12px;

    font-size: 11px;
    font-weight: 600;

    color: #111827;
}

.seller-content {
    display: flex;
    align-items: center;

    gap: 10px;
}


/* =====================================================
   SELLER AVATAR
   ===================================================== */

.seller-avatar {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #dff5ec;

    font-size: 19px;
}


/* =====================================================
   SELLER DETAILS
   ===================================================== */

.seller-details {
    display: flex;
    flex-direction: column;

    gap: 3px;

    flex: 1;
}

.seller-details strong {
    font-size: 10px;
    color: #111827;
}

.seller-details > span {
    font-size: 8px;
    color: #6b7280;
}

.seller-details .rating {
    color: #f59e0b;
    font-size: 9px;
}

.rating small {
    color: #6b7280;
    font-size: 8px;
}


/* =====================================================
   VIEW PROFILE
   ===================================================== */

.view-profile {
    padding: 8px 13px;

    border: 1px solid #80cdb0;
    border-radius: 5px;

    color: #059669;

    font-size: 9px;
    font-weight: 600;

    text-decoration: none;

    white-space: nowrap;

    transition: 0.2s;
}

.view-profile:hover {
    background: #effaf5;
}


/* =====================================================
   ACTION BUTTONS
   ===================================================== */

.action-buttons {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 14px;

    margin-top: 34px;
}


/* =====================================================
   WISHLIST FORM
   ===================================================== */

.wishlist-form {
    width: 100%;
    margin: 0;
}


/* =====================================================
   WISHLIST BUTTON
   ===================================================== */

.wishlist-btn {
    width: 100%;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    padding: 0 18px;

    border: 1px solid #059669;
    border-radius: 6px;

    background: #ffffff;

    color: #059669;

    font-family: inherit;
    font-size: 11px;
    font-weight: 600;

    cursor: pointer;

    transition: all 0.2s ease;
}

.wishlist-btn i {
    font-size: 14px;
}

.wishlist-btn:hover {
    background: #effaf5;
}

.wishlist-btn:active {
    transform: scale(0.98);
}


/* =====================================================
   BUY BUTTON
   ===================================================== */

.buy-btn {
    width: 100%;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid #059669;
    border-radius: 6px;

    background: #059669;
    color: #ffffff;

    font-size: 11px;
    font-weight: 600;

    text-decoration: none;

    transition: 0.2s;
}

.buy-btn:hover {
    background: #047857;
    border-color: #047857;
}


/* =====================================================
   RESPONSIVE
   ===================================================== */

@media (max-width: 900px) {

    .product-page {
        min-height: 100vh;
        padding: 20px 18px;
    }

    .product-container {
        grid-template-columns: 1fr;
    }

    .main-image {
        height: 380px;
    }

    .product-right {
        padding-top: 10px;
    }
}


@media (max-width: 550px) {

    .product-page {
        padding: 15px 12px;
    }

    .breadcrumb {
        font-size: 10px;
    }

    .main-image {
        height: 300px;
    }

    .title-row h1 {
        font-size: 18px;
    }

    .price {
        font-size: 19px;
    }

    .product-meta {
        flex-direction: column;
        gap: 9px;
    }

    .action-buttons {
        grid-template-columns: 1fr;
        margin-top: 20px;
    }

    .seller-content {
        flex-wrap: wrap;
    }
}

</style>


<div class="product-page">


    <!-- =====================================================
         BREADCRUMB
         ===================================================== -->

    <div class="breadcrumb">

        <a href="/home">
            Home
        </a>

        <span>›</span>

        <a href="/browse?category=<%= encodeURIComponent(product.category) %>">
            <%= product.category %>
        </a>

        <span>›</span>

        <span>
            <%= product.product_name %>
        </span>

    </div>


    <!-- =====================================================
         PRODUCT SECTION
         ===================================================== -->

    <div class="product-container">


        <!-- =====================================================
             LEFT SIDE
             ===================================================== -->

        <div class="product-left">

            <div class="main-image">

                <img
                    src="<%= product.image_url %>"
                    alt="<%= product.product_name %>"
                >

            </div>

        </div>


        <!-- =====================================================
             RIGHT SIDE
             ===================================================== -->

        <div class="product-right">


            <!-- =====================================================
                 TITLE
                 ===================================================== -->

            <div class="title-row">

                <h1>
                    <%= product.product_name %>
                </h1>

            </div>


            <!-- =====================================================
                 PRICE
                 ===================================================== -->

            <div class="price-section">

                <div class="price">

                    ₹<%= product.Price %>

                </div>

                <del>

                    ₹<%= product.original_price %>

                </del>

                <span class="discount">

                    <%= product.discount %>% OFF

                </span>

                <span class="stock">

                    In Stock

                </span>

            </div>


            <!-- =====================================================
                 PRODUCT META
                 ===================================================== -->

            <div class="product-meta">

                <span>

                    <i class="fa-regular fa-circle-check"></i>

                    <%= product.Product_condition %>

                </span>


                <span>

                    <i class="fa-regular fa-clock"></i>

                    <%
                        const purchased = new Date(product.purchase_date);
                        const today = new Date();

                        const days = Math.floor(
                            (today - purchased) /
                            (1000 * 60 * 60 * 24)
                        );
                    %>

                    <%= days %> days ago

                </span>


                <span>

                    <i class="fa-solid fa-location-dot"></i>

                    <%= product.city %>, <%= product.state %>

                </span>


                <span>

                    <i class="fa-regular fa-calendar"></i>

                    <%= new Date(product.created_at).toLocaleDateString(
                        'en-IN',
                        {
                            day: '2-digit',
                            month: 'short',
                            year: 'numeric'
                        }
                    ) %>

                </span>

            </div>


            <!-- =====================================================
                 DIVIDER
                 ===================================================== -->

            <div class="divider"></div>


            <!-- =====================================================
                 DESCRIPTION
                 ===================================================== -->

            <div class="description">

                <h3>
                    Description
                </h3>

                <p>
                    <%= product.description %>
                </p>

                <p>
                    Quantity: <%= product.quantity %>
                </p>

            </div>


            <!-- =====================================================
                 SELLER
                 ===================================================== -->

            <div class="seller-card">

                <h3>
                    Seller Information
                </h3>


                <div class="seller-content">


                    <div class="seller-avatar">
                        👨🏻
                    </div>


                    <div class="seller-details">

                        <strong>
                            <%= user.name %>
                        </strong>

                        <span>
                            <%= user.college %>
                        </span>

                        <span class="rating">

                            <i class="fa-solid fa-star"></i>

                            4.8

                            <small>
                                (25 Reviews)
                            </small>

                        </span>

                    </div>


                    <a
                        href="/profile"
                        class="view-profile"
                    >
                        View Profile
                    </a>

                </div>

            </div>


            <!-- =====================================================
                 ACTION BUTTONS
                 ===================================================== -->

            <div class="action-buttons">


                <!-- ================= WISHLIST ================= -->

                <form
                    action="/productDetails/wishlist"
                    method="POST"
                    class="wishlist-form"
                >

                    <input
                        type="hidden"
                        name="product_id"
                        value="<%= product.product_id %>"
                    >


                    <button
                        type="submit"
                        class="wishlist-btn"
                    >
                        <% if (wishlist && wishlist.wishlist_id) { %>
    <i class="fa-solid fa-heart"></i>
<% } else { %>
    <i class="fa-regular fa-heart"></i>
<% } %>
                        

                        <span>
                            Add to Wishlist
                        </span>

                    </button>

                </form>


                <!-- ================= BUY ================= -->

                <a
                    href="#"
                    class="buy-btn"
                >
                    Buy / Make Offer
                </a>


            </div>


        </div>

    </div>

</div>