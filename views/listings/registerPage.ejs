<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>CircuitX - Register</title>

    <link
        rel="stylesheet"
        href="/css/registerPage.css"
    >

</head>


<body>


<div class="register-container">


    <!-- ================= LEFT SIDE ================= -->

    <div class="logo-section">

        <div class="logo-circle"></div>

        <img
            src="/images/circuitx-logo.png"
            alt="CircuitX Logo"
            class="circuitx-logo"
        >

        <h2>
            CircuitX
        </h2>

        <p>
            Connect. Learn. Build.
        </p>

    </div>



    <!-- ================= RIGHT SIDE ================= -->

    <div class="form-section">

        <h1>
            Create Account
        </h1>

        <p class="subtitle">
            Join CircuitX today!
        </p>



        <form
            action="/register"
            method="POST"
            enctype="multipart/form-data"
        >

        <div class="profile-photo-section">

   

    <label
        for="profile_image"
        class="profile-upload-btn"
    >
         <div class="profile-preview">

        <img
            id="profilePreview"
            src="https://in.images.search.yahoo.com/images/view;_ylt=AwrPrptbUH9qeSgZk2a9HAx.;_ylu=c2VjA3NyBHNsawNpbWcEb2lkA2U4NzNhNTBjNTdhZjA1M2FhNTlkNjI3MWY1OGEzOGNhBGdwb3MDMQRpdANiaW5n?back=https%3A%2F%2Fin.images.search.yahoo.com%2Fsearch%2Fimages%3Fp%3Dprofile%2Bphoto%2Bicon%26ei%3DUTF-8%26type%3DE210IN1589G0%26fr%3Dmcafee%26fr2%3Dsa-gp-search%26tab%3Dorganic%26ri%3D1&w=1920&h=1920&imgurl=static.vecteezy.com%2Fsystem%2Fresources%2Fpreviews%2F018%2F765%2F757%2Foriginal%2Fuser-profile-icon-in-flat-style-member-avatar-illustration-on-isolated-background-human-permission-sign-business-concept-vector.jpg&rurl=https%3A%2F%2Far.inspiredpencil.com%2Fpictures-2023%2Fprofile-picture-icon&size=43KB&p=profile+photo+icon&oid=e873a50c57af053aa59d6271f58a38ca&fr2=sa-gp-search&fr=mcafee&tt=Profile+Picture+Icon&b=0&ni=160&no=1&ts=&tab=organic&sigr=yfyVTkDsufQo&sigb=2aiagLmQaP5T&sigi=yfO7prQE2E07&sigt=YVHwql0eunH.&.crumb=ffuwWpAAHM/&fr=mcafee&fr2=sa-gp-search&type=E210IN1589G0"
        >

    </div>
    Add Profile Photo
    </label>

    <input
        type="file"
        id="profile_image"
        name="profile_image"
        accept="image/*"
        required
    >

    <small>
        JPG, PNG or WEBP • Max 5MB
    </small>

</div>


            <!-- ================= FULL NAME ================= -->

            <div class="form-group">

                <label for="name">
                    Full Name
                </label>

                <input
                    type="text"
                    id="name"
                    name="username"
                    placeholder="Enter your full name"
                    required
                >

            </div>



            <!-- ================= EMAIL ================= -->

            <div class="form-group">

                <label for="email">
                    Email
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Enter your email"
                    required
                >

            </div>



            <!-- ================= PHONE ================= -->

            <div class="form-group">

                <label for="phone">
                    Phone Number
                </label>

                <input
                    type="tel"
                    id="phone"
                    name="phone"
                    placeholder="Enter your 10-digit phone number"
                    pattern="[0-9]{10}"
                    maxlength="10"
                    minlength="10"
                    inputmode="numeric"
                    required
                >

            </div>



            <!-- ================= PASSWORD ================= -->

            <div class="form-group">

                <label for="password">
                    Password
                </label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Create a password"
                    required
                >

            </div>



            <!-- ================= COLLEGE ================= -->

            <div class="form-group">

                <label for="college">
                    College Name
                </label>

                <input
                    type="text"
                    id="college"
                    name="college"
                    placeholder="Enter your college name"
                    required
                >

            </div>



            <!-- ================= REGISTER BUTTON ================= -->

            <button
                type="submit"
                class="register-btn"
            >

                Register

            </button>


        </form>



        <!-- ================= LOGIN ================= -->

        <p class="login-text">

            Already have an account?

            <a href="/login">
                Login
            </a>

        </p>


    </div>


</div>



<!-- ================= ERROR POPUP ================= -->

<% if (typeof error !== "undefined") { %>


<div
    id="errorPopup"
    class="error-popup"
>

    <span>
        <%= error %>
    </span>


    <button onclick="closePopup()">
        ×
    </button>

</div>



<script>

const profileInput =
    document.getElementById("profile_image");

const profilePreview =
    document.getElementById("profilePreview");


profileInput.addEventListener("change", function () {

    const file = this.files[0];

    if (!file) {
        return;
    }

    const reader = new FileReader();

    reader.onload = function (e) {

        profilePreview.src = e.target.result;

    };

    reader.readAsDataURL(file);

});

</script>

<% } %>


</body>

</html>