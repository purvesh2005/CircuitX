<% layout("/layouts/boilerplate") %>


<style>

.profile-page {
    min-height: calc(100vh - 70px);

    background: #f7f9f8;

    padding: 30px 16px 40px;
}


.profile-container {
    max-width: 900px;

    min-height: 600px;

    margin: auto;

    background: white;

    border: 1px solid #eeeeee;

    border-radius: 12px;

    overflow: hidden;

    box-shadow: 0 2px 15px rgba(0, 0, 0, 0.04);
}


/* ================= PROFILE HEADER ================= */

.profile-header {
    background: linear-gradient(
        135deg,
        #08a568 0%,
        #06b87a 100%
    );

    padding: 40px 30px 30px;

    text-align: center;

    color: white;

    position: relative;
}


.profile-avatar-large {
    width: 90px;
    height: 90px;

    border-radius: 50%;
    overflow: hidden;

    border: 3px solid rgba(255, 255, 255, 0.6);

    margin: 0 auto 15px;

    display: flex;
    align-items: center;
    justify-content: center;
}

.profile-avatar-large img {
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    display: block;
}


.profile-header h1 {
    font-size: 22px;

    font-weight: 700;

    margin-bottom: 5px;
}


.profile-header .profile-email {
    font-size: 13px;

    opacity: 0.9;
}


/* ================= PROFILE STATS ================= */

.profile-stats {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 15px;

    padding: 20px 30px;

    background: #fafafa;

    border-bottom: 1px solid #eeeeee;
}


.stat-card {
    text-align: center;

    padding: 15px 10px;

    background: white;

    border: 1px solid #eeeeee;

    border-radius: 8px;
}


.stat-card .stat-number {
    font-size: 24px;

    font-weight: 700;

    color: #08a568;

    margin-bottom: 4px;
}


.stat-card .stat-label {
    font-size: 11px;

    color: #666;

    font-weight: 500;
}


/* ================= PROFILE FORM ================= */

.profile-form-section {
    padding: 30px;
}


.profile-form-section h2 {
    font-size: 16px;

    font-weight: 700;

    margin-bottom: 20px;

    color: #222;
}


.form-grid {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 18px;
}


.form-group {
    display: flex;

    flex-direction: column;

    gap: 6px;
}


.form-group.full-width {
    grid-column: 1 / -1;
}


.form-group label {
    font-size: 12px;

    font-weight: 600;

    color: #333;
}


.form-group input {
    height: 40px;

    padding: 0 12px;

    border: 1px solid #ddd;

    border-radius: 6px;

    font-size: 13px;

    color: #333;

    outline: none;

    transition: border-color 0.2s;
}


.form-group input:focus {
    border-color: #08a568;

    box-shadow: 0 0 0 3px rgba(8, 165, 104, 0.1);
}


.form-group input[readonly] {
    background: #f5f5f5;

    color: #888;

    cursor: not-allowed;
}


.save-btn {
    height: 40px;

    padding: 0 30px;

    background: #08a568;

    color: white;

    border: none;

    border-radius: 6px;

    font-size: 13px;

    font-weight: 600;

    cursor: pointer;

    transition: background 0.2s;

    margin-top: 20px;
}


.save-btn:hover {
    background: #078b58;
}


/* ================= ERROR POPUP ================= */

.error-popup {
    position: fixed;

    top: 20px;

    right: 20px;

    background: #e55b5b;

    color: white;

    padding: 14px 20px;

    border-radius: 8px;

    font-size: 13px;

    font-weight: 500;

    display: flex;

    align-items: center;

    gap: 15px;

    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);

    z-index: 1000;

    transition: opacity 0.3s;
}


.error-popup button {
    background: none;

    border: none;

    color: white;

    font-size: 18px;

    cursor: pointer;

    line-height: 1;
}
html,
body {
    scrollbar-width: none;
    -ms-overflow-style: none;
    overflow-x: hidden;
}

html::-webkit-scrollbar,
body::-webkit-scrollbar {
    display: none;
}

/* ================= RESPONSIVE ================= */

@media (max-width: 650px) {

    .form-grid {
        grid-template-columns: 1fr;
    }

    .profile-stats {
        grid-template-columns: 1fr;
    }

    .profile-header {
        padding: 30px 20px 25px;
    }

    .profile-form-section {
        padding: 20px;
    }

}

</style>


<div class="profile-page">

    <div class="profile-container">


        <!-- ================= PROFILE HEADER ================= -->

        <div class="profile-header">

            <div class="profile-avatar-large">
                <img src="<%=user.profile_image%>" alt="">
            </div>

            <h1>
                <%= user.name %>
            </h1>

            <p class="profile-email">
                <%= user.email %>
            </p>

        </div>


        <!-- ================= PROFILE STATS ================= -->

        <div class="profile-stats">


            <div class="stat-card">

                <div class="stat-number">
                    <%= stats.total_listings || 0 %>
                </div>

                <div class="stat-label">
                    Total Listings
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-number">
                    <%= stats.total_views || 0 %>
                </div>

                <div class="stat-label">
                    Total Views
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-number">
                    ₹
                </div>

                <div class="stat-label">
                    Total Earnings
                </div>

            </div>


        </div>


        <!-- ================= PROFILE FORM ================= -->

        <div class="profile-form-section">

            <h2>
                Edit Profile
            </h2>


            <form
                action="/profile"
                method="POST"
            >


                <div class="form-grid">


                    <!-- FULL NAME -->

                    <div class="form-group">

                        <label for="name">
                            Full Name
                        </label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            value="<%= user.name %>"
                            required
                        >

                    </div>


                    <!-- EMAIL -->

                    <div class="form-group">

                        <label for="email">
                            Email
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            value="<%= user.email %>"
                            required
                        >

                    </div>


                    <!-- PHONE -->

                    <div class="form-group">

                        <label for="phone">
                            Phone Number
                        </label>

                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            value="<%= user.phone || '' %>"
                            pattern="[0-9]{10}"
                            maxlength="10"
                            minlength="10"
                            inputmode="numeric"
                            required
                        >

                    </div>


                    <!-- COLLEGE -->

                    <div class="form-group">

                        <label for="college">
                            College Name
                        </label>

                        <input
                            type="text"
                            id="college"
                            name="college"
                            value="<%= user.college || '' %>"
                            required
                        >

                    </div>


                    <!-- USER ID -->

                    <div class="form-group full-width">

                        <label for="user_id">
                            User ID
                        </label>

                        <input
                            type="text"
                            id="user_id"
                            value="<%= user.user_id %>"
                            readonly
                        >

                    </div>


                </div>


                <button
                    type="submit"
                    class="save-btn"
                >
                    Save Changes
                </button>


            </form>

        </div>


    </div>

</div>


<% if (typeof error !== "undefined") { %>

<div
    id="errorPopup"
    class="error-popup"
>

    <span>
        <%= error %>
    </span>

    <button onclick="closePopup()">
        ×
    </button>

</div>


<script>

setTimeout(() => {

    closePopup();

}, 3000);


function closePopup() {

    const popup =
        document.getElementById("errorPopup");

    if (popup) {

        popup.style.opacity = "0";

        setTimeout(() => {

            popup.remove();

        }, 300);

    }

}

</script>

<% } %>