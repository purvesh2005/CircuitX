<% layout("/layouts/boilerplate") %>

<style>
 /* =====================================================
   CIRCUITX - BROWSE PAGE
   ===================================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html,
body {
    width: 100%;
    min-height: 100%;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f8faf9;
    color: #1f2937;
}

a {
    text-decoration: none;
    color: inherit;
}


/* =====================================================
   MAIN PAGE
   ===================================================== */

.browse-page {
    width: 100%;
    max-width: 1280px;

    margin: 0 auto;

    padding: 22px 12px 40px;
}


/* =====================================================
   SEARCH + SELL
   ===================================================== */

.top-section {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    gap: 20px;

    margin-bottom: 24px;
}

.search-box {
    width: 560px;
    height: 46px;

    display: flex;
    align-items: center;

    background: #ffffff;

    border: 1px solid #dfe5e2;
    border-radius: 7px;

    overflow: hidden;
}

.search-box input {
    flex: 1;

    width: 100%;

    border: none;
    outline: none;

    padding: 0 16px;

    font-size: 14px;

    color: #374151;
}

.search-box input::placeholder {
    color: #9ca3af;
}

.search-box button {
    width: 52px;
    height: 100%;

    border: none;
    border-left: 1px solid #e5e7eb;

    background: white;

    font-size: 23px;

    color: #374151;

    cursor: pointer;
}

.sell-btn {
    display: flex;
    align-items: center;
    justify-content: center;

    height: 46px;

    padding: 0 24px;

    background: #059669;
    color: white;

    border-radius: 6px;

    font-size: 13px;
    font-weight: 600;

    white-space: nowrap;

    transition: 0.2s;
}

.sell-btn:hover {
    background: #047857;
}


/* =====================================================
   MAIN CONTENT
   ===================================================== */

.content {
    display: grid;

    grid-template-columns: 220px 1fr;

    gap: 35px;

    align-items: start;
}


/* =====================================================
   SIDEBAR
   ===================================================== */

.sidebar {
    min-width: 0;

    background: transparent;
}

.filter-section {
    padding-bottom: 22px;

    margin-bottom: 22px;

    border-bottom: 1px solid #e1e5e3;
}

.filter-section h3 {
    margin-bottom: 15px;

    font-size: 17px;
    font-weight: 600;

    color: #1f2937;
}


/* =====================================================
   CATEGORY LIST
   ===================================================== */

.category-list {
    list-style: none;
}

.category-list li {
    margin-bottom: 4px;

    border-radius: 6px;
}

.category-list li a {
    display: block;

    padding: 9px 11px;

    font-size: 13px;

    color: #4b5563;
}

.category-list li:hover {
    background: #edf8f3;
}

.category-list .selected {
    background: #e3f5ed;
}

.category-list .selected a {
    color: #059669;

    font-weight: 600;
}


/* =====================================================
   FILTERS
   ===================================================== */

.filter-group {
    margin-top: 21px;
}

.filter-group h4 {
    margin-bottom: 11px;

    font-size: 13px;
    font-weight: 600;

    color: #374151;
}

.filter-group label {
    display: flex;
    align-items: center;

    margin-bottom: 10px;

    font-size: 13px;

    color: #4b5563;

    cursor: pointer;
}

.filter-group input[type="checkbox"] {
    width: 15px;
    height: 15px;

    margin-right: 9px;

    accent-color: #059669;

    cursor: pointer;
}


/* =====================================================
   PRICE
   ===================================================== */

.price-range {
    width: 100%;

    accent-color: #059669;

    cursor: pointer;
}

.price-values {
    display: flex;

    justify-content: space-between;

    margin-top: 7px;

    font-size: 12px;

    color: #6b7280;
}


/* =====================================================
   LOCATION
   ===================================================== */

.filter-group select {
    width: 100%;
    height: 38px;

    padding: 0 10px;

    background: white;

    border: 1px solid #d5dcd8;

    border-radius: 5px;

    font-size: 12px;

    color: #4b5563;

    outline: none;

    cursor: pointer;
}


/* =====================================================
   APPLY FILTER
   ===================================================== */

.filter-btn {
    width: 100%;

    height: 38px;

    margin-top: 20px;

    border: none;

    border-radius: 5px;

    background: #059669;
    color: white;

    font-size: 12px;
    font-weight: 600;

    cursor: pointer;

    transition: 0.2s;
}

.filter-btn:hover {
    background: #047857;
}


/* =====================================================
   PRODUCTS AREA
   ===================================================== */

.products-area {
    min-width: 0;
}


/* =====================================================
   PRODUCTS HEADER
   ===================================================== */

.products-header {
    display: flex;

    align-items: center;
    justify-content: space-between;

    margin-bottom: 18px;
}

.products-header h2 {
    font-size: 20px;

    font-weight: 600;

    color: #1f2937;
}

.sort {
    display: flex;

    align-items: center;

    gap: 10px;

    font-size: 12px;

    color: #6b7280;
}

.sort select {
    height: 36px;

    padding: 0 12px;

    background: white;

    border: 1px solid #d8dedb;

    border-radius: 5px;

    font-size: 12px;

    color: #374151;

    outline: none;

    cursor: pointer;
}


/* =====================================================
   PRODUCT GRID
   ===================================================== */

.product-grid {
    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 18px;
}


/* =====================================================
   PRODUCT CARD
   ===================================================== */

.product-card {
    background: #ffffff;

    border: 1px solid #e1e5e3;

    border-radius: 8px;

    overflow: hidden;

    transition: 0.2s;
}

.product-card:hover {
    transform: translateY(-3px);

    box-shadow:
        0 6px 18px rgba(0, 0, 0, 0.08);
}


/* =====================================================
   PRODUCT IMAGE
   ===================================================== */

.product-image {
    width: 100%;
    height: 180px;

    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #f5f7f6;
}

.product-image img {
    width: 100%;
    height: 100%;

    object-fit: contain;
}


/* =====================================================
   WISHLIST
   ===================================================== */

.wishlist-btn {
    position: absolute;

    top: 10px;
    right: 10px;

    width: 34px;
    height: 34px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: none;

    border-radius: 50%;

    background: white;

    color: #9ca3af;

    font-size: 23px;

    cursor: pointer;

    box-shadow:
        0 2px 7px rgba(0, 0, 0, 0.10);
}

.wishlist-btn:hover {
    color: #ef4444;
}

.heart-red {
    color: #ef4444;
}

.discount-badge {
    position: absolute;

    left: 10px;
    top: 10px;

    padding: 4px 8px;

    background: #ef4444;
    color: white;

    border-radius: 4px;

    font-size: 10px;
    font-weight: 700;
}


/* =====================================================
   PRODUCT INFORMATION
   ===================================================== */

.product-info {
    padding: 14px 15px 15px;
}

.product-info h3 {
    margin-bottom: 11px;

    font-size: 14px;

    font-weight: 500;

    color: #1f2937;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;
}


/* =====================================================
   PRICE
   ===================================================== */

.price-row {
    display: flex;

    align-items: center;

    gap: 9px;
}

.price-row strong {
    font-size: 16px;

    font-weight: 600;

    color: #111827;
}

.price-row del {
    font-size: 11px;

    color: #9ca3af;
}

.price-row span {
    padding: 4px 7px;

    background: #e5f6ee;

    color: #059669;

    border-radius: 3px;

    font-size: 9px;

    font-weight: 600;
}


/* =====================================================
   LOCATION
   ===================================================== */

.location {
    margin-top: 12px;

    font-size: 11px;

    color: #6b7280;
}


/* =====================================================
   PAGINATION
   ===================================================== */

.pagination {
    width: 100%;
    min-height: 36px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 14px;

    margin-top: 35px;
    margin-bottom: 25px;

    box-sizing: border-box;
}

.pagination a {
    width: 32px;
    height: 32px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: none;
    border-radius: 5px;

    background: transparent;

    color: #4b5563;
    font-size: 12px;
    font-weight: 500;

    text-decoration: none;

    cursor: pointer;
    transition: 0.2s ease;
}

.pagination a:hover {
    color: #059669;
}

.pagination a.current {
    background: #059669;
    color: white;
    font-weight: 600;
}

.pagination .page-arrow {
    width: 24px;
    height: 32px;

    color: #6b7280;
    font-size: 22px;
    font-weight: 400;
}

.pagination .page-arrow:hover {
    color: #059669;
}

.pagination .dots {
    width: 20px;
    text-align: center;

    color: #6b7280;
    font-size: 12px;
}


/* =====================================================
   RESPONSIVE
   ===================================================== */

@media (max-width: 1100px) {

    .browse-page {
        padding-left: 15px;
        padding-right: 15px;
    }

    .content {
        grid-template-columns: 200px 1fr;

        gap: 25px;
    }

    .search-box {
        width: 450px;
    }

    .product-image {
        height: 165px;
    }
}


@media (max-width: 850px) {

    .content {
        grid-template-columns: 180px 1fr;

        gap: 20px;
    }

    .search-box {
        width: 350px;
    }

    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}


@media (max-width: 650px) {

    .top-section {
        justify-content: center;

        flex-wrap: wrap;
    }

    .search-box {
        width: 100%;
    }

    .sell-btn {
        width: 100%;
    }

    .content {
        grid-template-columns: 1fr;
    }

    .sidebar {
        display: none;
    }

    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));

        gap: 12px;
    }

    .product-image {
        height: 150px;
    }
}


@media (max-width: 450px) {

    .browse-page {
        padding: 15px 10px;
    }

    .product-grid {
        grid-template-columns: 1fr;
    }

    .products-header {
        flex-direction: column;

        align-items: flex-start;

        gap: 12px;
    }
}
html {
    scrollbar-width: none; /* Firefox */
}

html::-webkit-scrollbar {
    display: none; /* Chrome, Edge, Safari */
}

body {
    scrollbar-width: none;
}

body::-webkit-scrollbar {
    display: none;
}
</style>


<div class="browse-page">

    <!-- ================= TOP SEARCH ================= -->

    <div class="top-section">

        <form class="search-box" action="/browse" method="GET">
            <input
                type="text"
                name="search"
                placeholder="Search components, e.g. Arduino UNO"
                value="<%= search || '' %>"
            >
            <input type="hidden" name="category" value="<%= category || '' %>">
            <input type="hidden" name="condition" value="<%= condition || '' %>">
            <button type="submit">⌕</button>
        </form>

        <a href="/sell" class="sell-btn">
            Sell Component
        </a>

    </div>


    <!-- ================= MAIN CONTENT ================= -->

    <div class="content">

        <!-- ================= SIDEBAR ================= -->

        <aside class="sidebar">

            <!-- Categories -->

            <section class="filter-section">

                <h3>Categories</h3>

                <ul class="category-list">

                    <li class="<%= !category ? 'selected' : '' %>">
                        <a href="/browse?search=<%= encodeURIComponent(search || '') %>">
                            All Categories
                        </a>
                    </li>

                    <li class="<%= category === 'Resistors' ? 'selected' : '' %>">
                        <a href="/browse?category=Resistors&search=<%= encodeURIComponent(search || '') %>">Resistors</a>
                    </li>

                    <li class="<%= category === 'Capacitors' ? 'selected' : '' %>">
                        <a href="/browse?category=Capacitors&search=<%= encodeURIComponent(search || '') %>">Capacitors</a>
                    </li>

                    <li class="<%= category === 'Sensors' ? 'selected' : '' %>">
                        <a href="/browse?category=Sensors&search=<%= encodeURIComponent(search || '') %>">Sensors</a>
                    </li>

                    <li class="<%= category === 'Motors' ? 'selected' : '' %>">
                        <a href="/browse?category=Motors&search=<%= encodeURIComponent(search || '') %>">Motors</a>
                    </li>

                    <li class="<%= category === 'Power Supply' ? 'selected' : '' %>">
                        <a href="/browse?category=Power%20Supply&search=<%= encodeURIComponent(search || '') %>">Power Supply</a>
                    </li>

                    <li class="<%= category === 'ICs' ? 'selected' : '' %>">
                        <a href="/browse?category=ICs&search=<%= encodeURIComponent(search || '') %>">ICs</a>
                    </li>

                    <li class="<%= category === 'Microcontrollers' ? 'selected' : '' %>">
                        <a href="/browse?category=Microcontrollers&search=<%= encodeURIComponent(search || '') %>">Microcontrollers</a>
                    </li>

                    <li class="<%= category === 'Development Boards' ? 'selected' : '' %>">
                        <a href="/browse?category=Development%20Boards&search=<%= encodeURIComponent(search || '') %>">Development Board</a>
                    </li>

                    <li class="<%= category === 'Tools & Others' ? 'selected' : '' %>">
                        <a href="/browse?category=Tools%20%26%20Others&search=<%= encodeURIComponent(search || '') %>">Tools & Others</a>
                    </li>

                </ul>

            </section>


            <!-- ================= FILTERS ================= -->

            <form action="/browse" method="GET">

                <input type="hidden" name="search" value="<%= search || '' %>">
                <input type="hidden" name="category" value="<%= category || '' %>">

                <section class="filter-section">

                    <h3>Filters</h3>


                    <!-- Condition -->

                    <div class="filter-group">

                        <h4>Condition</h4>

                        <label>
                            <input
                                type="radio"
                                name="condition"
                                value=""
                                <%= !condition ? 'checked' : '' %>
                            >
                            All
                        </label>

                        <label>
                            <input
                                type="radio"
                                name="condition"
                                value="New"
                                <%= condition === 'New' ? 'checked' : '' %>
                            >
                            New
                        </label>

                        <label>
                            <input
                                type="radio"
                                name="condition"
                                value="Like New"
                                <%= condition === 'Like New' ? 'checked' : '' %>
                            >
                            Like New
                        </label>

                        <label>
                            <input
                                type="radio"
                                name="condition"
                                value="Good"
                                <%= condition === 'Good' ? 'checked' : '' %>
                            >
                            Good
                        </label>

                        <label>
                            <input
                                type="radio"
                                name="condition"
                                value="Used"
                                <%= condition === 'Used' ? 'checked' : '' %>
                            >
                            Used
                        </label>

                    </div>


                    <!-- Price Range -->

                    <div class="filter-group">

                        <h4>Max Price</h4>

                        <input
                            type="number"
                            name="maxPrice"
                            min="0"
                            placeholder="e.g. 5000"
                            value="<%= maxPrice || '' %>"
                            class="price-range"
                        >

                    </div>


                    <!-- Location -->

                    <div class="filter-group">

                        <h4>Location</h4>

                        <select name="location">

                            <option value="">
                                Select location
                            </option>

                            <option value="Pune" <%= location === 'Pune' ? 'selected' : '' %>>
                                Pune
                            </option>

                            <option value="Mumbai" <%= location === 'Mumbai' ? 'selected' : '' %>>
                                Mumbai
                            </option>

                            <option value="Delhi" <%= location === 'Delhi' ? 'selected' : '' %>>
                                Delhi
                            </option>

                            <option value="Bangalore" <%= location === 'Bangalore' ? 'selected' : '' %>>
                                Bangalore
                            </option>

                            <option value="Hyderabad" <%= location === 'Hyderabad' ? 'selected' : '' %>>
                                Hyderabad
                            </option>

                        </select>

                    </div>


                    <button type="submit" class="filter-btn">
                        Apply Filters
                    </button>

                </section>

            </form>

        </aside>


        <!-- ================= PRODUCTS AREA ================= -->

        <main class="products-area">


            <!-- Header -->

            <div class="products-header">

                <h2>All Components</h2>

                <div class="sort">

                    <span>Sort by:</span>

                    <form action="/browse" method="GET" style="margin:0;display:inline;">
                        <input type="hidden" name="search" value="<%= search || '' %>">
                        <input type="hidden" name="category" value="<%= category || '' %>">
                        <input type="hidden" name="condition" value="<%= condition || '' %>">
                        <input type="hidden" name="location" value="<%= location || '' %>">
                        <input type="hidden" name="maxPrice" value="<%= maxPrice || '' %>">
                        <select name="sort" onchange="this.form.submit()">

                            <option value="newest" <%= sort === 'newest' || !sort ? 'selected' : '' %>>
                                Newest First
                            </option>

                            <option value="price-low" <%= sort === 'price-low' ? 'selected' : '' %>>
                                Price: Low to High
                            </option>

                            <option value="price-high" <%= sort === 'price-high' ? 'selected' : '' %>>
                                Price: High to Low
                            </option>

                        </select>
                    </form>

                </div>

            </div>


            <!-- ================= PRODUCT GRID ================= -->

            <div class="product-grid">

                <% if (products.length === 0) { %>

                    <p style="grid-column:1/-1;text-align:center;color:#6b7280;padding:60px 0;font-size:14px;">
                        No components found. Try adjusting your filters.
                    </p>

                <% } %>

                <% for (let product of products) { %>

       <a
        href="/productDetails/<%= product.product_id %>"
        class="product-card"
    >

        <div class="product-image">

           <img src="<%= product.image_url %>" alt="<%= product.product_name %>">

            <form action="/wishlist/add" method="POST" style="margin:0;"
                  onclick="event.stopPropagation();">
                <input type="hidden" name="product_id" value="<%= product.product_id %>">
                <button class="wishlist-btn" type="submit">
                    <i class="fa-regular fa-heart"></i>
                </button>
            </form>

            <% if (product.discount > 0) { %>
            <span class="discount-badge">
                <%= product.discount %>% OFF
            </span>
            <% } %>

        </div>

        <div class="product-info">

            <h3>
                <%= product.product_name %>
            </h3>

            <div class="price-row">

                <strong>
                    ₹<%= product.Price %>
                </strong>

                <del>
                    ₹<%= product.original_price %>
                </del>

                <% if (product.discount > 0) { %>
                <span><%= product.discount %>% OFF</span>
                <% } %>

            </div>

            <p class="location">
                📍 <%= product.city %>
            </p>
</div>
        </a>

    

<% } %>
            </div>


            <!-- ================= PAGINATION ================= -->

            <%
                const page = Number(currentPage) || 1;
                const pages = Number(totalPages) || 1;

                const categoryParam = encodeURIComponent(category || "");
                const conditionParam = encodeURIComponent(condition || "");
                const searchParam = encodeURIComponent(search || "");
                const locationParam = encodeURIComponent(location || "");
                const maxPriceParam = encodeURIComponent(maxPrice || "");
                const sortParam = encodeURIComponent(sort || "");

                function pageUrl(pageNumber) {
                    return `?page=${pageNumber}&category=${categoryParam}&condition=${conditionParam}&search=${searchParam}&location=${locationParam}&maxPrice=${maxPriceParam}&sort=${sortParam}`;
                }
            %>

            <% if (pages > 1) { %>

                <div class="pagination">

                    <% if (page > 1) { %>
                        <a
                            href="<%= pageUrl(page - 1) %>"
                            class="page-arrow"
                            aria-label="Previous page"
                        >
                            ‹
                        </a>
                    <% } %>


                    <% for (let i = 1; i <= pages; i++) { %>

                        <% if (
                            i === 1 ||
                            i === pages ||
                            (i >= page - 1 && i <= page + 1)
                        ) { %>

                            <a
                                href="<%= pageUrl(i) %>"
                                class="<%= page === i ? 'current' : '' %>"
                            >
                                <%= i %>
                            </a>

                        <% } else if (
                            i === page - 2 ||
                            i === page + 2
                        ) { %>

                            <span class="dots">...</span>

                        <% } %>

                    <% } %>


                    <% if (page < pages) { %>
                        <a
                            href="<%= pageUrl(page + 1) %>"
                            class="page-arrow"
                            aria-label="Next page"
                        >
                            ›
                        </a>
                    <% } %>

                </div>

            <% } %>

        </main>

    </div>

</div>