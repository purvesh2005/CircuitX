<% layout("/layouts/boilerplate") %>

<style>
    /* =========================
   ADD COMPONENT PAGE
========================= */

.page-container {
    width: 100%;
    padding: 30px 16px 40px;
    background: #f7f9f8;
    min-height: calc(100vh - 70px);
}


/* Main Card */

.form-card {
    max-width: 1100px;
    margin: auto;

    background: white;

    border-radius: 12px;

    padding: 28px 32px 34px;

    border: 1px solid #eeeeee;

    box-shadow: 0 2px 15px rgba(0, 0, 0, 0.04);
}


.form-card > h1 {
    font-size: 22px;
    margin-bottom: 25px;
    font-weight: 700;
}


/* =========================
   TWO COLUMN LAYOUT
========================= */

.form-layout {
    display: grid;

    grid-template-columns: 1.25fr 0.85fr;

    gap: 55px;
}


.left-form,
.right-form {
    min-width: 0;
}


.form-layout h3 {
    font-size: 14px;

    margin-bottom: 12px;

    font-weight: 700;
}


/* =========================
   FORM GROUP
========================= */

.form-group {
    margin-bottom: 14px;
}


.form-group label {
    display: block;

    font-size: 12px;

    font-weight: 600;

    margin-bottom: 6px;

    color: #333;
}


.form-group label span {
    color: #e53935;
}


/* Inputs */

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;

    border: 1px solid #dedede;

    border-radius: 5px;

    background: white;

    font-family: inherit;

    font-size: 10px;

    color: #333;

    outline: none;

    transition: 0.2s;
}


.form-group input,
.form-group select {
    height: 36px;

    padding: 0 10px;
}


.form-group textarea {
    height: 86px;

    padding: 10px;

    resize: vertical;
}


.form-group input::placeholder,
.form-group textarea::placeholder {
    color: #999;
}


/* Focus */

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    border-color: #08a568;

    box-shadow:
        0 0 0 2px rgba(8, 165, 104, 0.08);
}


/* =========================
   TWO INPUT ROW
========================= */

.form-row {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 12px;
}


/* Quantity */

.quantity {
    max-width: 48%;
}


/* =========================
   IMAGE UPLOAD
========================= */

.upload-box {
    height: 150px;

    border: 1px dashed #cfcfcf;

    border-radius: 7px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;

    position: relative;

    cursor: pointer;

    transition: 0.2s;

    margin-bottom: 24px;
}


.upload-box:hover {
    border-color: #08a568;

    background: #fbfffd;
}


.upload-box i {
    font-size: 24px;

    margin-bottom: 10px;

    color: #333;
}


.upload-box h4 {
    font-size: 10px;

    margin-bottom: 6px;
}


.upload-box p {
    font-size: 8px;

    color: #777;

    margin-bottom: 4px;
}


.upload-box small {
    font-size: 7px;

    color: #999;
}


/* File input covers entire box */

.upload-box input[type="file"] {
    position: absolute;

    inset: 0;

    opacity: 0;

    cursor: pointer;
}


/* =========================
   OTHER DETAILS
========================= */

.other-title {
    margin-bottom: 12px !important;
}


/* =========================
   LIST COMPONENT BUTTON
========================= */

.list-btn {
    width: 100%;

    height: 38px;

    border: none;

    border-radius: 6px;

    background: #08a568;

    color: white;

    font-size: 11px;

    font-weight: 600;

    cursor: pointer;

    margin-top: 7px;

    transition: 0.2s;
}


.list-btn:hover {
    background: #078b58;
}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 700px) {

    .page-container {
        padding: 20px 12px;
    }


    .form-card {
        padding: 22px 18px;
    }


    .form-layout {
        grid-template-columns: 1fr;

        gap: 20px;
    }


    .quantity {
        max-width: 100%;
    }

}


@media (max-width: 480px) {

    .form-row {
        grid-template-columns: 1fr;
    }


    .form-card > h1 {
        font-size: 16px;
    }

}
html {
    scrollbar-width: none; /* Firefox */
}

html::-webkit-scrollbar {
    display: none; /* Chrome, Edge, Safari */
}

body {
    scrollbar-width: none;
}

body::-webkit-scrollbar {
    display: none;
}
</style>

<form
    id="productForm"
    action="/sell"
    method="POST"
    enctype="multipart/form-data"
>

    <div class="form-card">

        <h1>Add New Component</h1>

        <div class="form-layout">

            <!-- LEFT SIDE -->
            <div class="left-form">

                <h3>Basic Information</h3>

                <!-- Title -->
                <div class="form-group">
                    <label>
                        Title <span>*</span>
                    </label>

                    <input
                        type="text"
                        name="title"
                        placeholder="e.g. Arduino UNO R3"
                        required
                    >
                </div>


                <!-- Category + Condition -->
                <div class="form-row">

                    <div class="form-group">
                        <label>
                            Category <span>*</span>
                        </label>

                        <select name="category" required>
                            <option value="">Select Category</option>
                            <option value="Microcontrollers">Microcontrollers</option>
                            <option value="Sensors">Sensors</option>
                            <option value="Development Boards">Development Boards</option>
                            <option value="Resistors">Resistors</option>
                            <option value="Capacitors">Capacitors</option>
                            <option value="Motors">Motors</option>
                            <option value="Power Supply">Power Supply</option>
                            <option value="ICs">ICs</option>
                            <option value="Tools & Others">Tools & Others</option>
                        </select>
                    </div>


                    <div class="form-group">
                        <label>
                            Condition <span>*</span>
                        </label>

                        <select name="condition" required>
                            <option value="">Select Condition</option>
                            <option value="New">New</option>
                            <option value="Like New">Like New</option>
                            <option value="Good">Good</option>
                            <option value="Used">Used</option>
                        </select>
                    </div>

                </div>


                <!-- Price -->
                <div class="form-row">

                    <div class="form-group">
                        <label>
                            Price (₹) <span>*</span>
                        </label>

                        <input
                            type="number"
                            name="price"
                            placeholder="e.g. 450"
                            required
                        >
                    </div>


                    <div class="form-group">
                        <label>
                            Original Price (₹)
                        </label>

                        <input
                            type="number"
                            name="originalPrice"
                            placeholder="e.g. 900"
                        >
                    </div>

                </div>


                <!-- Quantity -->
                <div class="form-group quantity">
                    <label>
                        Quantity <span>*</span>
                    </label>

                    <input
                        type="number"
                        name="quantity"
                        placeholder="e.g. 1"
                        min="1"
                        required
                    >
                </div>


                <!-- Description -->
                <div class="form-group">

                    <label>
                        Description <span>*</span>
                    </label>

                    <textarea
                        name="description"
                        placeholder="Describe your component..."
                        required
                    ></textarea>

                </div>

            </div>


            <!-- RIGHT SIDE -->
            <div class="right-form">

               <div class="upload-box">

    <i class="fa-solid fa-cloud-arrow-up"></i>

    <h4 id="uploadText">Upload Images</h4>

    <p id="uploadPara">Drag & drop or click to browse</p>

    <small id="uploadSmall">Up to 5mb image file</small>

    <input
        type="file"
        id="imageInput"
        name="image"
        accept="image/jpeg, image/jpg, image/png"
        required
        onchange="showFileName(this)"
    >

</div>

<script>
    function showFileName(input) {

        const uploadText = document.getElementById("uploadText");

        if (input.files.length === 1) {
            uploadText.innerText = input.files[0].name + " selected";
            uploadPara.innerText = "";
            uploadSmall.innerText = "";
        }
        else {
            uploadText.innerText = "Upload Images";
        }
    }
</script>

                <!-- Other Details -->
                <h3 class="other-title">
                    Other Details
                </h3>


                <!-- City -->
                <div class="form-group">

                    <label>
                        City <span>*</span>
                    </label>

                    <input
                        type="text"
                        name="city"
                        placeholder="e.g. Pune"
                        required
                    >

                </div>


                <!-- State -->
                <div class="form-group">

                    <label>
                        State <span>*</span>
                    </label>

                    <input
                        type="text"
                        name="state"
                        placeholder="e.g. Maharashtra"
                        required
                    >

                </div>


                <!-- Date -->
                <div class="form-group">

                    <label>
                        Date Purchased
                    </label>

                    <input
                        type="date"
                        name="date"
                        required
                    >

                </div>


                <!-- Submit -->
                <button
                    type="submit"
                    class="list-btn"
                >
                    List Component
                </button>

            </div>

        </div>

    </div>

</form>

